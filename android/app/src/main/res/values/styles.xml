<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Branded launch screen shown while the Android process starts. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Window behind the Flutter UI once it is running. Matches the app's
         warm-cream scaffold so there is no colour flash on handoff. -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/ibudaya_cream</item>
    </style>
</resources>
